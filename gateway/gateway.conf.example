# Скопіюйте в gateway.conf (він у .gitignore -- паролі Wi-Fi не потрапляють у git).
#
# Список відомих мереж: кожен рядок wifi_ssid починає новий запис, wifi_pass
# одразу після нього -- пароль цієї мережі. Шлюз бере запис, що збігається з
# Wi-Fi, до якої Pi підключена ЗАРАЗ; змінили мережу Pi -- плати
# перенастроюються на нову самі. Якщо мережі в списку нема, пароль шукається
# в NetworkManager (nmcli, у т.ч. через sudo -n).
wifi_ssid = НазваМережі1
wifi_pass = Пароль1

wifi_ssid = НазваМережі2
wifi_pass = Пароль2

# Необов'язково (за замовчуванням IP шлюз визначає сам):
# gateway_ip = 192.168.2.2
# udp_port = 5005
# tcp_port = 5006

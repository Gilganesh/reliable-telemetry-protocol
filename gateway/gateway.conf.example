# Скопіюйте в gateway.conf (він у .gitignore -- пароль Wi-Fi не потрапляє в git).
# Усе необов'язкове: якщо рядка нема, шлюз спробує визначити сам
# (IP з мережевих інтерфейсів, SSID/пароль активного Wi-Fi через nmcli).
wifi_ssid = НазваМережі
wifi_pass = ПарольWiFi
# gateway_ip = 192.168.2.2
# udp_port = 5005
# tcp_port = 5006

# Copy to gateway.conf (ignored by git, so Wi-Fi passwords never get committed).
#
# Known networks: every wifi_ssid line starts a new entry and the wifi_pass line
# right after it is that network's password. The gateway picks the entry that
# matches the Wi-Fi the host is currently connected to and re-provisions nodes
# when the host switches networks. If the current network is not listed, the
# password is looked up in NetworkManager (nmcli, also via sudo -n).
wifi_ssid = MyNetwork1
wifi_pass = Password1

wifi_ssid = MyNetwork2
wifi_pass = Password2

# Optional overrides (by default the gateway detects its own IP):
# gateway_ip = 192.168.2.2
# udp_port = 5005
# tcp_port = 5006
